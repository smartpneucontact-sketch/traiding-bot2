###############################################################################
#  combo-v2-bot — environment variables for local + Railway deploy
###############################################################################
#  Copy this file to .env locally (or set as Railway service variables).
#  NEVER commit .env — it's git-ignored.
#
#  The bot defaults to Alpaca PAPER trading. To go live you would point
#  base_url at https://api.alpaca.markets and use a live key/secret pair,
#  but that's not the supported configuration for combo_v2.
###############################################################################

# ── Alpaca paper account (one Alpaca account per slot; combo_v2 = slot 1) ──
MODEL_COMBO_V2_ALPACA_KEY=
MODEL_COMBO_V2_ALPACA_SECRET=

# Dashboard write protection. Without this, anyone with the URL can edit
# slot settings via the Settings panel. Set to a long random string.
DASHBOARD_ADMIN_TOKEN=

# Override the persistent data directory (default: /app/data inside Docker)
# DATA_DIR=/app/data

# Override the daily rebalance schedule (Railway runs UTC).
# Default 13:35 UTC = 09:35 ET (5 min after open). Cron format: "M H * * 1-5"
# DAILY_REBALANCE_CRON=35 13 * * 1-5
